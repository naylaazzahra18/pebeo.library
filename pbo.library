using pebeo;
using System;

namespace pebeo
{
    public class Item  //Kelas Item untuk menyimpan informasi tentang item
    {
        public string Judul { get; set; }
        public int Tahun { get; set; }

        public Item(string judul, int tahun)
        {
            Judul = judul;
            Tahun = tahun;
        }
        public virtual string Deskripsi()
        {
            return $"Item: {Judul}, {Tahun}";
        }
        
        public void InfoItem()
        {
            Console.WriteLine($"Judul: {Judul}, Tahun: {Tahun}");
        }
    }
}

    public class Buku : Item //Kelas Buku yang mewarisi dari kelas Item
{
    public string Penulis { get; set; }

    public Buku (string judul, int tahun, string penulis) : base(judul, tahun)
    {
        Penulis = penulis;
    }
    public void CekPenulis()
    {
        Console.WriteLine($"Penulis buku '{Judul}' adalah {Penulis}");
    }
    public override string Deskripsi()
    {
        return $"Buku: {Judul}, {Tahun}, Penulis: {Penulis}";
    }
}

    public class Majalah : Item //Kelas Majalah yang mewarisi dari kelas Item
{
    public int Edisi { get; set; }

    public Majalah(string judul, int tahun, int edisi) : base(judul, tahun)
    {
        Edisi = edisi; 
    }
    public void InfoEdisi()
    {
        Console.WriteLine($"Majalah '{Judul}' Edisi : {Edisi}");
    }
    public override string Deskripsi()
    {
        return $"Majalah '{Judul} ({Tahun})' Edisi: {Edisi}";
    }
}

    public class Novel : Buku //Kelas Novel yang mewarisi dari kelas Buku
{
    public Novel(string judul, int tahun, string penulis) : base(judul, tahun, penulis) { }

    public void BacaSinopsis()
    {
        Console.WriteLine($"Sinopsis novel '{Judul}' : oleh {Penulis}");
    }
    public string Deskripsi()
    {
        return $"Novel: {Judul}, {Tahun}, Penulis : {Penulis}";
    }
}

    public class Komik : Buku //Kelas Komik yang mewarisi dari kelas Buku
{
    public Komik(string judul, int tahun, string penulis) : base(judul, tahun, penulis) { }

    public void TampilkanIlustrasi()
    {
        Console.WriteLine($"Menampilkan Ilustrasi komik '{Judul}' oleh {Penulis}");
    }
    public override string Deskripsi()
    {
        return $"Komik: {Judul}, {Tahun}, Penulis: {Penulis}";  
    }
}

    public class MajalahAnak : Majalah //Kelas MajalahAnak yang mewarisi dari kelas Majalah
{
    public MajalahAnak(string judul, int tahun, int edisi) : base(judul, tahun, edisi) { }
    public void KategoriAnak()
    {
        Console.WriteLine($"Kategori anak '{Judul}' termasuk kategori majalah untuk anak-anak");
    }
    public override string Deskripsi()
    {
        return $"Majalah Anak: {Judul}, {Tahun}, Edisi: {Edisi}";
    }
}

    public class MajalahTeknologi : Majalah //Kelas MajalahRemaja yang mewarisi dari kelas Majalah
{
    public MajalahTeknologi(string judul, int tahun, int edisi) : base(judul, tahun, edisi) { }
    public void TopikTeknologi()
    {
        Console.WriteLine($"Majalah Teknologi '{Judul}' termasuk kategori majalah untuk remaja");
    }
    public override string Deskripsi()
    {
        return $"Majalah Teknologi: {Judul}, {Tahun}, Edisi: {Edisi}";
    }
}

    public class Perpustakaan //Kelas Perpustakaan untuk menyimpan koleksi item
{
    private List<Item> daftarItem;
    public Perpustakaan()
    {
        daftarItem = new List<Item>();
    }
    public void TambahItem(Item item)
    {
        daftarItem.Add(item);
    }
    public void DaftarItem()
    {

        Console.WriteLine("=== DAFTAR ITEM PERPUSTAKAAN ===");
        foreach (var item in daftarItem)
        {
            Console.WriteLine(item.Deskripsi());
        }
    }
}

    class Program //Kelas Program untuk menjalankan program
{
    static void Main(string[] args)
    {
        Perpustakaan perpus = new Perpustakaan();

        Majalah majalah = new Majalah("Majalah Sains", 2023, 5);
        Novel novel = new Novel("Novel Perjuangan", 2022, "John Doe");
        Komik komik = new Komik("Komik Sweet", 2021, "Jane Smith");
        MajalahAnak majalahAnak = new MajalahAnak("Majalah Anak Ceria", 2023, 3);
        MajalahTeknologi majalahTeknologi = new MajalahTeknologi("Majalah Teknologi Canggih", 2024, 2);

        perpus.TambahItem(majalah);
        perpus.TambahItem(novel);
        perpus.TambahItem(komik);
        perpus.TambahItem(majalahAnak);
        perpus.TambahItem(majalahTeknologi);

        perpus.DaftarItem();

        Console.WriteLine("\n=== POLYMORPHISM ===");
        List<Item> daftarItem = new List<Item>();
        daftarItem.Add(majalah);
        daftarItem.Add(novel);
        daftarItem.Add(komik);
        daftarItem.Add(majalahAnak);
        daftarItem.Add(majalahTeknologi);
        foreach (var item in daftarItem)
        {
            Console.WriteLine(item.Deskripsi());
        }

        Console.WriteLine("\n=== METHOD KHUSUS ===");
        majalah.InfoEdisi();
        novel.BacaSinopsis();
        komik.TampilkanIlustrasi();
        majalahAnak.KategoriAnak();
        majalahTeknologi.TopikTeknologi();

        Console.WriteLine("\n=== SOAL 1: Deskripsi() pada Novel dan Majalah ===");
        Console.WriteLine(novel.Deskripsi());
        Console.WriteLine(majalah.Deskripsi());

        Console.WriteLine("\n=== SOAL 2: BacaSinopsis() pada Novel ===");
        novel.BacaSinopsis();

        Console.WriteLine("\n=== SOAL 3: Informasi lengkap Novel ===");
        novel.InfoItem();
        Console.WriteLine($"Penulis: {novel.Penulis}");
        Console.WriteLine(novel.Deskripsi());

        Console.WriteLine("\n=== SOAL 4: TopikTeknologi() pada MajalahTeknologi ===");
        majalahTeknologi.TopikTeknologi();

        Console.WriteLine("\n=== SOAL 5: Variabel Item berisi objek Komik ===");
        Item itemKomik = komik;

        Console.WriteLine(itemKomik.Deskripsi());
        ((Komik)itemKomik).TampilkanIlustrasi(); 

        Console.ReadKey();
    }
}